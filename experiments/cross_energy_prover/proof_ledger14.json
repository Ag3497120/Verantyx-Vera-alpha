  "add(max(a, b), min(a, b)) = add(add(b, a), len(nil))": "failed",
  "add(max(a, b), min(a, b)) = add(add(a, 0), add(0, b))": "failed",
  "add(max(a, b), min(a, b)) = add(a, b)": "failed",
  "add(min(a, b), max(a, b)) = add(a, b)": "failed",
  "min(a, b) = a": "refuted",
  "max(a, b) = add(a, b)": "refuted",
  "min(s(a), a) = s(a)": "refuted"
 }
}