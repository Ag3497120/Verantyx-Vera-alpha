  "mul(add(a, b), c) = add(mul(a, c), mul(b, c))": "failed",
  "add(len(y), len(z)) = len(app(y, z))": "proved",
  "len(app(app(x, nil), z)) = len(app(x, z))": "proved",
  "app(app(x, y), z) = app(x, app(y, z))": "proved",
  "app(z, app(x, y)) = app(app(z, x), y)": "proved",
  "len(app(z, nil)) = len(z)": "proved",
  "len(app(app(x, y), z)) = add(add(len(x), len(y)), len(z))": "failed",
  "add(mul(0, b), a) = a": "proved",
  "mul(add(a, b), add(a, b)) = add(mul(a, a), add(mul(a, b), add(mul(b, a), mul(b, b))))": "failed",
  "mul(a, add(b, add(c, n))) = add(mul(a, b), add(mul(a, c), mul(a, n)))": "failed",
  "add(mul(0, n), b) = b": "proved",
  "mul(mul(a, add(b, c)), n) = add(mul(mul(a, b), n), mul(mul(a, c), n))": "failed",
  "add(mul(add(a, b), c), mul(add(a, b), n)) = mul(add(a, b), add(c, n))": "failed"
 }
}